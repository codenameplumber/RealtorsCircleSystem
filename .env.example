APP_NAME=Laravel
# Never ship APP_ENV=local / APP_DEBUG=true to a public host: the debug error
# page renders the full environment, including DB, AWS and mail credentials.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true once the site is served over HTTPS so the session cookie is
# never transmitted in the clear.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production uses the native Resend API transport. Set RESEND_KEY to your
# key (starts with "re_") and MAIL_FROM_ADDRESS to an address on a domain
# verified in Resend. Locally, MAIL_MAILER=log writes mail to the log file.
MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS="support@realtorscircle.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# WhatsApp/n8n-facing internal API — shared secret only n8n should hold.
WHATSAPP_API_KEY=

VITE_APP_NAME="${APP_NAME}"
